          "ruleId": "vuln-0003",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Global credentials file shared by all sessions — last-connector-wins cross-user overwrite\n\nAll connected sessions share one global credentials file, so each new Namecheap connection silently overwrites every other session's stored key and every connected session acts on whoever connected last."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
