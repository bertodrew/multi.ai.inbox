# Copy to deploy/local/.env on the server. Never commit the real file.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Database roles: owner (migrations only), runtime, system (workers). Use distinct values.
MAI_OWNER_PASSWORD=change-me-owner
MAI_APP_PASSWORD=change-me-app
MAI_SYSTEM_PASSWORD=change-me-system
# Public names: PTR of the server IP must equal MAI_HOSTNAME.
MAI_HOSTNAME=mx.example.eu
MAI_API_HOST=api.example.eu
# Domain for free inboxes, added once with: mai admin domain-add -name agents.example.eu -mx mx.example.eu
MAI_SHARED_DOMAIN=agents.example.eu
# Until Hetzner opens outbound port 25: an EU relay, e.g. smtp://USER:PASS@email-smtp.eu-central-1.amazonaws.com:587
MAI_SMTP_RELAY=
# People signing in. MAI_AUTH_SECRET is the HMAC key of the access tokens: it
# must be at least 32 bytes, and every replica must share it. Without it the
# sign in endpoints answer 501 auth_disabled; API keys are unaffected.
# Generate one with: openssl rand -base64 48
MAI_AUTH_SECRET=REPLACE_WITH_32_RANDOM_BYTES
# Site that hosts /login, and the public base of this API (magic links use it).
MAI_WEB_ORIGIN=http://localhost:3000
MAI_PUBLIC_API_URL=http://localhost:8080
# Sender of the sign in mail; the relay must be allowed to send for the domain.
# Defaults to no-reply@MAI_SHARED_DOMAIN.
# MAI_AUTH_MAIL_FROM=no-reply@agents.example.eu
# OAuth clients (Google: Authorized redirect URI <api>/v0/auth/callback,
# GitHub: Authorization callback URL <api>/v0/auth/callback). A provider
# without both values answers 501 provider_not_configured.
# MAI_GOOGLE_CLIENT_ID=
# MAI_GOOGLE_CLIENT_SECRET is set in the cluster secret, never here
# MAI_GITHUB_CLIENT_ID=
# MAI_GITHUB_CLIENT_SECRET is set in the cluster secret, never here
# How long temporary send failures are retried before message.failed (Go duration, default 120h = 5 days).
# MAI_SEND_MAX_AGE=120h
# Stripe billing is off unless BOTH keys below are set; every billing endpoint
# then answers 501 billing_disabled. See docs/billing-enable.md. Never commit
# real values here.
# MAI_STRIPE_SECRET_KEY=sk_test_...
# MAI_STRIPE_WEBHOOK_SECRET=whsec_...
# MAI_BILLING_RETURN_URL=http://localhost:3000/billing
# Price ids make a plan buyable; a plan without them cannot be bought.
# MAI_STRIPE_PRICE_BUILDER_MONTHLY=price_...
# MAI_STRIPE_PRICE_BUILDER_YEARLY=price_...
# MAI_STRIPE_PRICE_GROWTH_MONTHLY=price_...
# MAI_STRIPE_PRICE_GROWTH_YEARLY=price_...
# MAI_STRIPE_PRICE_TEAM_MONTHLY=price_...
# MAI_STRIPE_PRICE_TEAM_YEARLY=price_...
MAI_VERSION=latest
