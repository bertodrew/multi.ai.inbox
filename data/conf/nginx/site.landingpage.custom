# multi.ai.inbox landing page (fork) — incluso dentro il server block via site.*.custom
# Pagina: /landingpage/ (statico), API: /landingpage/api/ (fastcgi verso landing-php)

location = /landingpage { return 301 /landingpage/; }

location ^~ /landingpage/ {
    alias /landingpage-html/;
    index index.html;
}

location ^~ /landingpage/api/ {
    rewrite ^/landingpage/api/(.*)$ /api/$1 break;
    include /etc/nginx/fastcgi_params;
    fastcgi_pass landing-php:9000;
    fastcgi_param SCRIPT_FILENAME /www$fastcgi_script_name;
    fastcgi_read_timeout 60s;
}
