# multi.ai.inbox landing page (fork) — incluso dentro il server block via site.*.custom
# Pagina: /landingpage/ (statico), API: /landingpage/api/ (proxy verso il container Go)

location = /landingpage { return 301 /landingpage/; }

location ^~ /landingpage/ {
    alias /landingpage-html/;
    index index.html;
}

location ^~ /landingpage/api/ {
    proxy_pass http://landing-go:8080/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
}
